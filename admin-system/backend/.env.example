# =====================================================================
# SKYWINGS ADMIN BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting production or staging servers:
#   cp .env.example .env
# =====================================================================

# Server Port
PORT=5001

# Environment Mode: development | production | test
NODE_ENV=development

# JWT Secret Key for Admin Authentication Token Signing
# CRITICAL: Always override this in production with a strong, random 64+ char secret.
# Example generator: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production_2026_skywings
